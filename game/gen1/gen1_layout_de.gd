static var _red: Dictionary = {}
static var _blue: Dictionary = {}


static func is_german(id: StringName) -> bool:
	return RomRegistry.language_of(id) == "de"


static func red() -> Dictionary:
	if _red.is_empty():
		_red = Gen1Layout.RED_BLUE.duplicate()
		_red.merge(RED, true)
	return _red


static func blue() -> Dictionary:
	if _blue.is_empty():
		_blue = red().duplicate()
		for key: String in _blue:
			var run: String = key.get_slice(".", 0)
			if Gen1Layout.BLUE_SHIFT.has(run):
				_blue[key] = int(_blue[key]) + int(Gen1Layout.BLUE_SHIFT[run])
	return _blue


static func trainer_ai_shift(id: StringName) -> int:
	return TRAINER_AI_SHIFT if is_german(id) else 0


static func prints_nothing(id: StringName, run: String, slot: String) -> bool:
	return is_german(id) and EMPTY_TEXTS.has("%s.%s" % [run, slot])


static func ui(id: StringName, english: String) -> String:
	return String(UI.get(english, english)) if is_german(id) else english


static func localized(english: String) -> String:
	return String(UI.get(english, english)) if Gen1Text.language() == "de" else english


static func word(id: StringName, english: String) -> String:
	return String(WORDS.get(english, english)) if is_german(id) else english
